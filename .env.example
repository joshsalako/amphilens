CVAT_URL=http://localhost:8080
CVAT_TOKEN=your-cvat-token

# Optional Modal cloud GPU training. Process variables take precedence over
# these values; both take precedence over the user-scoped `cloud login` file.
# AmphiLens uses only these two keys from `.env`. Never commit actual tokens.
# MODAL_TOKEN_ID=your-modal-token-id
# MODAL_TOKEN_SECRET=your-modal-token-secret
