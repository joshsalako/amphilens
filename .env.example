CVAT_URL=http://localhost:8080
CVAT_TOKEN=your-cvat-token

# Optional Modal cloud GPU training. A user-scoped credentials file created by
# `amphilens cloud login` takes lower priority than these process variables.
# Never commit actual token values.
# MODAL_TOKEN_ID=your-modal-token-id
# MODAL_TOKEN_SECRET=your-modal-token-secret
