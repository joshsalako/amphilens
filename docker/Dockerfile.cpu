FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/amphilens
COPY pyproject.toml README.md AGENTS.md ./
COPY src ./src

RUN python -m pip install --upgrade pip \
    && python -m pip install ".[cli,ui,inference]"

EXPOSE 8501
ENTRYPOINT ["python", "-m", "streamlit"]
CMD ["run", "/opt/amphilens/src/amphilens/ui.py", "--server.address=0.0.0.0", "--server.port=8501"]

